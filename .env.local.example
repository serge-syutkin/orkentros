# Copy this file to .env.local and fill in the values. .env.local is gitignored
# and must never be committed.

# Stripe secret key. Test keys start with sk_test_, live keys with sk_live_.
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx

# The price of the book, created in the Stripe product catalogue. Prices are
# per account AND per mode, so test and live have different ids — and so does
# the client's account when the shop moves over to it.
STRIPE_PRICE_ID=price_xxx

# Absolute origin used for Stripe's success/cancel redirects. Leave this unset
# on Netlify: the runtime provides URL and DEPLOY_PRIME_URL automatically.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
